name: Reusable workflow Docker Build

on:
  workflow_call:
    inputs:
      REPOSITORY:
        required: true
        type: string
      DEPLOYMENT_NAME:
        required: true
        type: string
      SHORTSHA:
        required: true
        type: string
      JDK_VERSION:
        default: '17'
        required: false
        type: string
    secrets: 
      user: 
        required: true
      token:
        required: true
        

jobs:
  Build-Package:
    name: Upload Binaries
    runs-on: [ self-hosted, Linux, de-c360-runners-dev ]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        
      - uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: ${{inputs.JDK_VERSION}}
          
      #rerun Maven build to upload artifacts after CI checks
      - name: Cache Maven dependencies
        uses: actions/cache@v4
        with:
          path: ~/.m2/repository
          key: ${{ runner.os }}-maven-${{ hashFiles('**/pom.xml') }}
          restore-keys: |
            ${{ runner.os }}-maven
      
      - name: Maven Package
        run: |-
          export GITHUB_USER=${{env.user}}
          export GITHUB_TOKN=${{env.token}}
          export GITHUB_TOKEN=${{env.token}}
          mvn -s $GITHUB_WORKSPACE/settings.xml -U clean package -Drevision=${{inputs.SHORTSHA}} -Dmaven.test.skip=true
        env:
          user: ${{ secrets.user }}
          token: ${{ secrets.token }}

      - name: Upload artifact
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: binary-files
          path: target/

  Docker-Build:
    name: Build Image
    needs: Build-Package
    runs-on: [ de-c360-runners-dev ]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        
      - name: Download artifact
        uses: actions/download-artifact@v4
        with:
          name: binary-files # The name you used when uploading the artifact
          path: target/

      - name: Build and Push
        run: |-
          ls -ltr ./target
          gcloud auth configure-docker
          gcloud auth list
          docker build -t ${{ inputs.REPOSITORY }}/${{ inputs.DEPLOYMENT_NAME }}:${{ inputs.SHORTSHA }} -t ${{ inputs.REPOSITORY }}/${{ inputs.DEPLOYMENT_NAME }}:latest --build-arg VER=${{ inputs.SHORTSHA }} .
          gcloud auth configure-docker -q
          gcloud auth list
          docker image push --all-tags ${{ inputs.REPOSITORY }}/${{ inputs.DEPLOYMENT_NAME }}
