name: Reusable workflow example
permissions:
        contents: 'read'
        id-token: 'write'
        packages: 'read'

on:
  workflow_call:
    inputs:
      REPOSITORY:
        required: true
        type: string
      DEPLOYMENT_NAME:
        required: true
        type: string
      SHORTSHA:
        required: true
        type: string
      NAMESPACE:
        required: true
        type: string  


jobs:
  #cdp repositories uses helm, while the rest uses .helm
  Helm-Dev-Deploy:
    name: Deploy to Dev
    permissions:
        contents: 'read'
        id-token: 'write'
        packages: 'read' 
    runs-on: pg_custom_runner_ubuntu22    
    steps:  
      - uses: actions/checkout@v4
      - name: Set up Google Cloud Auth
        uses: google-github-actions/auth@v2
        with:
         workload_identity_provider: ${{ vars.WIF_PROVIDER }}
         service_account: ${{ vars.WIF_SA }}
         project_id: ${{ vars.GCP_PROJECT_ID }}
         create_credentials_file: true
      - name: Setup gcloud
        uses: google-github-actions/setup-gcloud@v3 
      - name: Deploy 
        run: |-
          if [ -d "helm" ]; then
            echo " helm directory exists"
            cd helm
            ls -ltr
            helm upgrade --install ${{ inputs.DEPLOYMENT_NAME }} ${{ inputs.DEPLOYMENT_NAME }}  -f ./${{ inputs.DEPLOYMENT_NAME }}/values.yaml -f ./${{ inputs.DEPLOYMENT_NAME }}/values.yaml --set image.tag=${{ inputs.SHORTSHA }} -n ${{ inputs.NAMESPACE }}
          else
            echo " .helm directory exists"
            cd .helm
            ls -ltr
            helm upgrade --install ${{ inputs.DEPLOYMENT_NAME }} ${{ inputs.DEPLOYMENT_NAME }}  -f ./${{ inputs.DEPLOYMENT_NAME }}/values.yaml -f ./${{ inputs.DEPLOYMENT_NAME }}/values-dev.yaml --set image.tag=${{ inputs.SHORTSHA }} -n ${{ inputs.NAMESPACE }}
          fi
